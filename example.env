# ── Provider ───────────────────────────────────────────────────────────────────
# Set ONE of the API keys below. SnapSolve auto-detects the provider.
# Priority when multiple keys are set: claude → openai → groq

# Anthropic / Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI / ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Explicit provider override (optional): "claude", "openai", or "groq"
# SNAPSOLVE_PROVIDER=groq

# ── Model ──────────────────────────────────────────────────────────────────────
# Defaults per provider:
#   claude  → claude-sonnet-4-6
#   openai  → gpt-4o
#   groq    → meta-llama/llama-4-scout-17b-16e-instruct
# SNAPSOLVE_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# ── Hotkey ─────────────────────────────────────────────────────────────────────
# Uses pynput key names: <ctrl>, <shift>, <alt>, <cmd>, <space>, etc.
SNAPSOLVE_HOTKEY=<ctrl>+<shift>+s

# ── Behaviour ──────────────────────────────────────────────────────────────────
# SNAPSOLVE_SYSTEM_PROMPT=You are an expert assistant. Analyze the screenshot carefully. If there is a question or multiple-choice problem visible, identify the correct answer and explain why clearly and concisely. Be direct and accurate.
# SNAPSOLVE_MAX_TOKENS=1024
